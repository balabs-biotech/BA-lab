{
  "contract": "BA-LABS/ENGINE-MANIFEST",
  "contract_version": "1.0.0",
  "engine": {
    "engine_id": "biological.context.features",
    "engine_version": "0.1.0",
    "display_name": "Biological context coverage and descriptive features"
  },
  "domain": "biological",
  "entrypoint": "ba_engine_contract.biological_context_features:analyze_biological_context_features",
  "runtime": {
