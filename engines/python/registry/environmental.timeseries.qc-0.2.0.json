{
  "contract": "BA-LABS/ENGINE-MANIFEST",
  "contract_version": "1.0.0",
  "engine": {
    "engine_id": "environmental.timeseries.qc",
    "engine_version": "0.2.0",
    "display_name": "Environmental time-series quality control"
  },
  "domain": "environmental",
  "entrypoint": "ba_engine_contract.environmental_timeseries_qc:analyze_environmental_timeseries_qc",
  "runtime": {
    "language": "python",
    "version": "3.12"
  },
  "capabilities": {
    "database_access": false,
    "network_access": false,
    "external_data_access": false,
    "filesystem_write": false
  },
  "resource_limits": {
    "timeout_seconds": 15,
    "memory_mb": 256,
    "max_concurrency": 2
  },
  "determinism": {
    "deterministic_analysis": true,
    "randomness_allowed": false
  },
  "input_contract": "BA-LABS/ENGINE@1.0.0",
  "output_contract": "BA-LABS/ENGINE-RESULT@1.0.0",
  "description": "Screens normalized measurements and location-scoped external weather observations for missing data, timestamp duplicates, sampling gaps and robust statistical outliers. Environmental inputs retain provider/dataset provenance and must not mix sources. Does not provide biological diagnosis or intervention recommendations."
