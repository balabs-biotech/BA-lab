{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ba-labs:bal-json:v1:record",
  "title": "BA Labs JSON record envelope",
  "description": "Versioned interchange envelope for traceable biological and environmental records. It is not a database write API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "record_type",
    "record_id",
    "organization_id",
    "created_at",
    "data",
    "provenance"
  ],
  "properties": {
    "contract": {
      "const": "BA-LABS/JSON"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "measurement",
        "observation"
      ]
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension payloads. Extensions must not redefine core fields.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "measurement"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ba-labs:bal-json:v1:measurement"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "observation"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ba-labs:bal-json:v1:observation"
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "user",
            "sensor",
            "import",
            "external_api",
            "ai_assisted",
            "system"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "software": {
          "type": "string",
          "minLength": 1
        },
        "operator_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "reviewed",
            "approved",
            "rejected"
          ]
        }
      }
    }
  }
}
