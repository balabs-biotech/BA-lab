{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ba-labs.dz/bal-json/v1/record.schema.json",
  "title": "BA Labs BAL-JSON v1 record",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "record_type",
    "record_id",
    "organization_id",
    "created_at",
    "data",
    "provenance"
  ],
  "properties": {
    "contract": {
      "const": "BA-LABS/JSON"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "enum": [
        "measurement",
        "observation"
      ]
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "review_status"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "reviewed",
            "rejected"
          ]
        },
        "source_model": {
          "type": "string",
          "maxLength": 120
        },
        "source_reference": {
          "type": "string",
          "maxLength": 2048
        },
        "created_by": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "measurement"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "https://schemas.ba-labs.dz/bal-json/v1/measurement.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "observation"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "https://schemas.ba-labs.dz/bal-json/v1/observation.schema.json"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
