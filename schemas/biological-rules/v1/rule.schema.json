{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ba-labs:biological-rules:v1:rule",
  "title": "BA Labs Biological Rule",
  "description": "Versioned rule metadata. A reviewed status is an explicit human assertion; schema validation does not verify scientific sources or thresholds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "version",
    "status",
    "domain",
    "target",
    "variable_code",
    "unit_code",
    "min",
    "max",
    "sources"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "retired"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "variable_code": {
      "type": "string",
      "minLength": 1
    },
    "unit_code": {
      "type": "string",
      "minLength": 1
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "applies_to": {
      "$ref": "#/$defs/applies_to"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taxon_code": {
          "type": "string",
          "minLength": 1
        },
        "strain_code": {
          "type": "string",
          "minLength": 1
        },
        "growth_stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "taxon_code"
          ],
          "properties": {
            "taxon_code": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "strain_code"
          ],
          "properties": {
            "strain_code": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "citation"
      ],
      "properties": {
        "type": {
          "enum": [
            "publication",
            "standard",
            "validated_internal_protocol",
            "dataset",
            "expert_review"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewed_at"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "culture_id": {
          "type": "string",
          "minLength": 1
        },
        "strain_id": {
          "type": "string",
          "minLength": 1
        },
        "growth_stage": {
          "type": "string",
          "minLength": 1
        },
        "medium_code": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "$ref": "#/$defs/review"
          }
        }
      }
    }
  ]
}
