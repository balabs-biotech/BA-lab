{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ba-labs.dz/biological/v1/context-assessment.schema.json",
  "title": "BA Labs biological context assessment v1",
  "description": "Structured value payload for biological.context_assessment.v1. This schema validates analytical output structure, not scientific validity.",
  "type": "object",
  "required": [
    "result_type",
    "result_version",
    "subject",
    "coverage",
    "observed_facts",
    "derived_features",
    "findings",
    "hypotheses"
  ],
  "properties": {
    "result_type": {
      "const": "biological.context_assessment"
    },
    "result_version": {
      "const": "1.0.0"
    },
    "subject": {
      "type": "object",
      "required": [
        "organization_id",
        "subject_type",
        "subject_id",
        "biological_contexts"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_type": {
          "enum": [
            "culture",
            "plant",
            "batch"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "culture_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "plant_culture_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "batch_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "experimental_unit_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "genetic_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "identity_assertion_state": {
          "enum": [
            "documented",
            "not_documented",
            "conflicting"
          ]
        },
        "identity_assertions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "assertion_code",
              "assertion_version",
              "subject_type",
              "organism_id",
              "strain_id",
              "assertion_type",
              "assertion_value",
              "evidence_level",
              "content_sha256",
              "source_reference_id",
              "source_reference_version",
              "source_reference_sha256",
              "reviewed_at",
              "valid_from",
              "valid_to"
            ],
            "properties": {
              "assertion_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "assertion_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "subject_type": {
                "enum": [
                  "organism",
                  "strain"
                ]
              },
              "organism_id": {
                "type": "string",
                "format": "uuid"
              },
              "strain_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "assertion_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "assertion_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence_level": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_reference_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "source_reference_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "source_reference_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "valid_from": {
                "type": "string",
                "format": "date"
              },
              "valid_to": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        },
        "biological_contexts": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/biologicalContext"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "requested_window",
        "observed_window",
        "source_record_count",
        "excluded_record_count",
        "missing_context",
        "temporal_gaps"
      ],
      "properties": {
        "requested_window": {
          "$ref": "#/$defs/timeWindow"
        },
        "observed_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "record_counts_by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "missing_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "temporal_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "duration_seconds"
            ],
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              },
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "observed_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observedFact"
      }
    },
    "derived_features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedFeature"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "environmental_quality_control": {
      "type": "object",
      "required": [
        "state",
        "upstream_execution_id",
        "upstream_result_id",
        "artifact_sha256",
        "outcome",
        "quality_flags",
        "limitations",
        "value"
      ],
      "properties": {
        "state": {
          "enum": [
            "passed",
            "review_required"
          ]
        },
        "upstream_execution_id": {
          "type": "string",
          "format": "uuid"
        },
        "upstream_result_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome": {
          "enum": [
            "success",
            "insufficient_data",
            "out_of_domain",
            "review_required"
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "value": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "biologicalContext": {
      "type": "object",
      "required": [
        "context_id",
        "valid_from",
        "valid_to",
        "organism_kind",
        "taxon_code",
        "strain_code",
        "cultivar_code",
        "culture_stage",
        "substrate_code",
        "production_system",
        "context_tags",
        "genetic_reference"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "format": "uuid"
        },
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "organism_kind": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "taxon_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "strain_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "cultivar_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "culture_stage": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "substrate_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "production_system": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "context_tags": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "genetic_reference": {
          "$ref": "#/$defs/geneticReference"
        }
      },
      "additionalProperties": false
    },
    "geneticReference": {
      "type": "object",
      "required": [
        "status",
        "strain_id",
        "organism_id",
        "designation",
        "origin",
        "source_description",
        "scientific_name",
        "common_name",
        "taxonomy_source",
        "taxonomy_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_specified",
            "unresolved",
            "resolved"
          ]
        },
        "strain_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "organism_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "designation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "source_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "scientific_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "common_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "taxonomy_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "taxonomy_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      },
      "additionalProperties": false
    },
    "timeWindow": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "observedFact": {
      "type": "object",
      "required": [
        "fact_code",
        "statement",
        "observed_at",
        "source_record_ids"
      ],
      "properties": {
        "fact_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_record_ids": {
          "$ref": "#/$defs/sourceReferences"
        },
        "value": {},
        "unit_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "derivedFeature": {
      "type": "object",
      "required": [
        "feature_code",
        "value",
        "method",
        "method_version",
        "unit_code",
        "source_record_ids"
      ],
      "properties": {
        "feature_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "value": {
          "type": [
            "number",
            "integer"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "method_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "unit_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "source_record_ids": {
          "$ref": "#/$defs/sourceReferences"
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_code",
        "statement",
        "evidence_state",
        "supporting_record_ids",
        "contradicting_record_ids"
      ],
      "properties": {
        "finding_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence_state": {
          "enum": [
            "supported",
            "limited",
            "conflicting",
            "insufficient_data"
          ]
        },
        "supporting_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "contradicting_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "derived_feature_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
          }
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "hypothesis_code",
        "statement",
        "status",
        "supporting_record_ids",
        "contradicting_record_ids",
        "requires_validation"
      ],
      "properties": {
        "hypothesis_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "const": "unverified"
        },
        "supporting_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "contradicting_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "requires_validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
