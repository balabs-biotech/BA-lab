{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ba-labs.dz/engine/v1/request.schema.json",
  "title": "BA Labs scientific engine request v1",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "request_id",
    "created_at",
    "engine",
    "scope",
    "input",
    "parameters"
  ],
  "properties": {
    "contract": {
      "const": "BA-LABS/ENGINE"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine": {
      "type": "object",
      "required": [
        "engine_id",
        "engine_version"
      ],
      "properties": {
        "engine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "organization_id"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "culture_id": {
          "type": "string",
          "format": "uuid"
        },
        "plant_culture_id": {
          "type": "string",
          "format": "uuid"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "location_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "record_ids",
        "snapshot_sha256",
        "records"
      ],
      "properties": {
        "record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record_id",
              "record_type",
              "payload_sha256",
              "data"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "format": "uuid"
              },
              "record_type": {
                "enum": [
                  "measurement",
                  "observation",
                  "environmental_observation"
                ]
              },
              "payload_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "data": {
                "type": "object"
              },
              "context": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "dataset_id",
          "content_sha256",
          "retrieved_at"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dataset_version": {
            "type": "string",
            "maxLength": 100
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "upstream_artifacts": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "contract",
          "contract_version",
          "role",
          "execution_id",
          "result_id",
          "request_id",
          "engine_id",
          "engine_version",
          "completed_at",
          "input_snapshot_sha256",
          "scope",
          "result",
          "artifact_sha256"
        ],
        "properties": {
          "contract": {
            "const": "BA-LABS/UPSTREAM-ENGINE-ARTIFACT"
          },
          "contract_version": {
            "const": "1.0.0"
          },
          "role": {
            "const": "environmental_qc"
          },
          "execution_id": {
            "type": "string",
            "format": "uuid"
          },
          "result_id": {
            "type": "string",
            "format": "uuid"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "engine_id": {
            "const": "environmental.timeseries.qc"
          },
          "engine_version": {
            "const": "0.2.0"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "input_snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "object",
            "required": [
              "organization_id",
              "location_id",
              "window_start",
              "window_end"
            ],
            "properties": {
              "organization_id": {
                "type": "string",
                "format": "uuid"
              },
              "location_id": {
                "type": "string",
                "format": "uuid"
              },
              "window_start": {
                "type": "string",
                "format": "date-time"
              },
              "window_end": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "result": {
            "type": "object",
            "required": [
              "outcome",
              "value",
              "limitations",
              "quality_flags",
              "provenance"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "success",
                  "insufficient_data",
                  "out_of_domain",
                  "review_required"
                ]
              },
              "value": {
                "type": "object"
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "quality_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provenance": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "type": "object",
            "properties": {
              "engine_id": {
                "const": "biological.context.features"
              }
            },
            "required": [
              "engine_id"
            ]
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "properties": {
              "record_ids": {
                "minItems": 0
              },
              "records": {
                "minItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "input": {
            "properties": {
              "record_ids": {
                "minItems": 1
              },
              "records": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
