{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ba-labs.dz/engine/v1/response.schema.json",
  "title": "BA Labs scientific engine response v1",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "request_id",
    "execution_id",
    "engine",
    "input_snapshot_sha256",
    "status",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "contract": {
      "const": "BA-LABS/ENGINE-RESULT"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "engine": {
      "type": "object",
      "required": [
        "engine_id",
        "engine_version"
      ],
      "properties": {
        "engine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": false
    },
    "input_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object",
      "required": [
        "outcome",
        "value",
        "limitations",
        "quality_flags",
        "provenance"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "success",
            "insufficient_data",
            "out_of_domain",
            "review_required"
          ]
        },
        "value": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
          }
        },
        "confidence": {
          "type": "object",
          "required": [
            "value",
            "method",
            "calibration_reference"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "calibration_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "algorithm",
            "libraries"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "libraries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "additionalProperties": false
              }
            },
            "source_references": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "execution_environment": {
              "type": "object",
              "required": [
                "engine_manifest_sha256",
                "source_revision",
                "python_version",
                "dependencies"
              ],
              "properties": {
                "engine_manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "python_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "container_image_digest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "version"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                      "version": { "type": "string", "minLength": 1, "maxLength": 80 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "error": {}
        },
        "required": [
          "result"
        ],
        "not": {
          "type": "object",
          "properties": {
            "error": {}
          },
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "result": {}
        },
        "required": [
          "error"
        ],
        "not": {
          "type": "object",
          "properties": {
            "result": {}
          },
          "required": [
            "result"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
